{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coslash.io/schemas/session-backup-db-rows-v1.json",
  "title": "coSlash attributed shared-database rows v1",
  "description": "Canonical documents are limited to 67108864 encoded bytes and 100000 array items in aggregate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "database", "tables"],
  "properties": {
    "schemaVersion": { "const": "session-backup-db-rows/v1" },
    "database": { "$ref": "#/$defs/identifier" },
    "tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/table" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\\\\\u0000-\\u0020\\u007f]+$"
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns", "rows"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1048576 }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/row" }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memberId", "values"],
      "properties": {
        "memberId": { "$ref": "#/$defs/identifier" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/value" }
        }
      }
    },
    "value": {
      "oneOf": [
        { "$ref": "#/$defs/nullValue" },
        { "$ref": "#/$defs/integerValue" },
        { "$ref": "#/$defs/realValue" },
        { "$ref": "#/$defs/textValue" },
        { "$ref": "#/$defs/blobValue" }
      ]
    },
    "nullValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "null" },
        "value": { "const": "" }
      }
    },
    "integerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "integer" },
        "value": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7]|-(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-8]))$"
        }
      }
    },
    "realValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "real" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "textValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "text" },
        "value": { "type": "string", "maxLength": 1048576 }
      }
    },
    "blobValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "blob" },
        "value": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$",
          "maxLength": 1048576
        }
      }
    }
  }
}
