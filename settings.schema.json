{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/centauri-ai/coslash/main/settings.schema.json",
  "title": "coSlash global settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "synthesis", "launch"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/centauri-ai/coslash/main/settings.schema.json"
    },
    "version": { "const": 1 },
    "syncPaused": { "type": "boolean", "description": "Pause this Local device's automatic Hub sync." },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "backend", "model"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backend": {
          "enum": ["claude-cli", "codex_exec", "opencode", "cursor-cli", "pi-cli"]
        },
        "model": {
          "description": "Model id passed to the selected CLI. Settings offers a short list per backend, but any model that CLI can reach is accepted, including models served through an API proxy or a third-party provider. For the opencode and pi-cli backends, \"default\" passes no model and lets the CLI resolve one.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "examples": [
            "claude-haiku-4-5",
            "gpt-6-luna",
            "opencode/deepseek-v4-flash-free",
            "auto",
            "default"
          ]
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme"],
      "properties": {
        "theme": { "enum": ["light", "dark"] }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal"],
      "properties": {
        "terminal": { "enum": ["terminal", "iterm2", "windows-terminal"] }
      }
    },
    "remote": {
      "description": "One optional Linux host monitored through an existing OpenSSH alias or a simple user@host destination. SFTP is always available when permitted; the optional Linux collection helper requires explicit in-app consent before installation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sshAlias", "enabled"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^r_[0-9a-f]{16}$"
        },
        "sshAlias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9.-]*)$"
        },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
