{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "agent-task/1"
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "board_tick",
            "day_report",
            "ask"
          ]
        },
        "orgId": {
          "type": "string"
        },
        "teamName": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "board_tick": {
          "type": "object",
          "properties": {
            "tick": {
              "type": "string",
              "format": "date-time"
            },
            "window": {
              "$ref": "#/$defs/window"
            },
            "lastReport": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "inputDigest": {
                  "type": "string"
                },
                "insightsAsOf": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "inputDigest",
                "insightsAsOf"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "tick",
            "window"
          ],
          "additionalProperties": false
        },
        "day_report": {
          "type": "object",
          "properties": {
            "slot": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}#[123]/3$"
            },
            "window": {
              "$ref": "#/$defs/window"
            },
            "timezone": {
              "type": "string"
            }
          },
          "required": [
            "slot",
            "window",
            "timezone"
          ],
          "additionalProperties": false
        },
        "ask": {
          "type": "object",
          "properties": {
            "channelId": {
              "type": "string"
            },
            "channelName": {
              "type": "string"
            },
            "threadTs": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "question": {
              "type": "string"
            },
            "askedBy": {
              "type": "string"
            }
          },
          "required": [
            "channelId",
            "channelName",
            "threadTs",
            "ts",
            "question",
            "askedBy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "orgId",
        "teamName",
        "expiresAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "board_tick"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "board_tick"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "day_report"
                  ]
                },
                {
                  "required": [
                    "ask"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "day_report"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "day_report"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "board_tick"
                  ]
                },
                {
                  "required": [
                    "ask"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ask"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "ask"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "board_tick"
                  ]
                },
                {
                  "required": [
                    "day_report"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "mcp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "url",
        "token",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "ok",
            "soft_limit"
          ]
        },
        "usedPct": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "state",
        "usedPct"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "task",
    "mcp",
    "budget"
  ],
  "additionalProperties": false,
  "$defs": {
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    }
  }
}
